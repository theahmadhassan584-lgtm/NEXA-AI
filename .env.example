# ============================================================
# NEXA AI - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Claude / Anthropic ---
ANTHROPIC_API_KEY=your_claude_api_key_here

# --- Database ---
# SQLite (dev): sqlite:///./nexa_dev.db
# PostgreSQL (prod): postgresql://user:pass@host:5432/nexa_db
DATABASE_URL=sqlite:///./nexa_dev.db

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Agent Configuration ---
AGENT_MAX_STEPS=15
AGENT_STEP_TIMEOUT=30
AGENT_MODEL=claude-sonnet-4-20250514

# --- Tool Configuration ---
ENABLE_WEB_SEARCH=true
ENABLE_PAGE_RETRIEVAL=true
ENABLE_DOCUMENT_QA=true
ENABLE_DATA_EXTRACTION=true
ENABLE_FILE_OPS=true
ENABLE_MCP_CONNECTORS=false

# Allowed workspace directory for file operations (absolute path)
FILE_OPS_WORKSPACE=./workspace

# Blocklisted domains (comma-separated) for page retrieval
BLOCKED_DOMAINS=

# --- Web Search API (optional) ---
# If using Bing Search API or similar
SEARCH_API_KEY=
SEARCH_API_ENDPOINT=

# --- MCP Connectors (optional) ---
MCP_GOOGLE_DRIVE_CREDENTIALS=
MCP_SLACK_TOKEN=

# --- Security ---
# Rate limiting (requests per minute per session)
RATE_LIMIT_RPM=30

# Max file upload size in MB
MAX_UPLOAD_SIZE_MB=10

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
